<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.B07DemoSummer2024" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="android:fontFamily">@font/roboto_condensed_regular</item>
        <item name="fontFamily">@font/roboto_condensed_regular</item>
        <item name="android:spinnerItemStyle">@style/CustomSpinnerItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/CustomSpinnerDropDownItem</item>
    </style>

    <style name="CustomSpinnerItem" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:fontFamily">@font/roboto_condensed_regular</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="CustomSpinnerDropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:fontFamily">@font/roboto_condensed_regular</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">#FFFFFF</item>
    </style>
</resources>
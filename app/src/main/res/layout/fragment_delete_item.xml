<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF"
    tools:context=".DeleteItemFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_delete_artifact"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="#F5F5F5"
            app:title="Delete Artifact"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ITEM TITLE / ID SECTION -->
        <TextView
            android:id="@+id/textViewTitleHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ARTIFACT NAME OR LOT NUMBER *"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar_delete_artifact"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="e.g., LOT001 or Tang 'Sancai' Box"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewTitleHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CATEGORY SECTION -->
        <TextView
            android:id="@+id/textViewCategoryHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CATEGORY"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewCategoryHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- DELETE BUTTON -->
        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="DELETE ARTIFACT"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:letterSpacing="0.05"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#D32F2F"
            app:layout_constraintTop_toBottomOf="@+id/spinnerCategory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CANCEL BUTTON -->
        <Button
            android:id="@+id/buttonCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:fontFamily="@font/roboto_condensed_regular"
            android:textColor="#808080"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/buttonDelete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
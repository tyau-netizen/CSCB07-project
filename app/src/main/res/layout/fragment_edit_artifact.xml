<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_edit_artifact"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="2dp"
        app:title="Edit Artifact"
        app:titleTextColor="#222222"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:navigationIconTint="#B09867" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <ImageView
                android:id="@+id/iv_edit_image"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="centerCrop"
                android:background="#E0E0E0" />

            <Button
                android:id="@+id/btn_change_image"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/roboto_condensed_regular"
                android:text="Change Image"
                android:textColor="#B09867"
                app:strokeColor="#B09867" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_bold"
                android:text="LOT NUMBER"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="#B09867" />

            <TextView
                android:id="@+id/tv_edit_lot_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/roboto_condensed_bold"
                android:textSize="16sp"
                android:textColor="#222222" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Artifact Name"
                app:hintTextColor="#B09867"
                app:boxStrokeColor="#B09867">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="#222222" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Description"
                app:hintTextColor="#B09867"
                app:boxStrokeColor="#B09867">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="#222222"
                    android:inputType="textMultiLine"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_bold"
                android:text="CATEGORY"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="#B09867" />
            <Spinner
                android:id="@+id/spinner_edit_category"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_bold"
                android:text="MATERIAL"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="#B09867" />
            <Spinner
                android:id="@+id/spinner_edit_material"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_bold"
                android:text="DYNASTY/PERIOD"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="#B09867" />
            <Spinner
                android:id="@+id/spinner_edit_dynasty"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Cultural Origin"
                app:hintTextColor="#B09867"
                app:boxStrokeColor="#B09867">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_cultural_origin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="#222222" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Dimensions"
                app:hintTextColor="#B09867"
                app:boxStrokeColor="#B09867">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_dimensions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="#222222" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Condition Report"
                app:hintTextColor="#B09867"
                app:boxStrokeColor="#B09867">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_condition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="#222222" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Current Location"
                app:hintTextColor="#B09867"
                app:boxStrokeColor="#B09867">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="#222222" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Acquisition Method"
                app:hintTextColor="#B09867"
                app:boxStrokeColor="#B09867">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_acquisition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="#222222" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Provenance"
                app:hintTextColor="#B09867"
                app:boxStrokeColor="#B09867">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_provenance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="#222222" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Accession Number"
                app:hintTextColor="#B09867"
                app:boxStrokeColor="#B09867">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_accession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="#222222" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Notes"
                app:hintTextColor="#B09867"
                app:boxStrokeColor="#B09867">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="#222222"
                    android:inputType="textMultiLine"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_save_artifact_changes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#B09867"
                android:fontFamily="@font/roboto_condensed_bold"
                android:letterSpacing="0.05"
                android:text="SAVE CHANGES"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
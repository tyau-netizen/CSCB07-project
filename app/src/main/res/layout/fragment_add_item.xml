<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".AddItemFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- MANDATORY FIELDS -->
        <TextView
            android:id="@+id/textViewLotNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Lot Number *"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextLotNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="e.g., LOT001"
            android:inputType="text"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewLotNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Name *"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextLotNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Artifact name"
            android:inputType="text"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Description *"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Category *"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewCategory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewMaterial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Material *"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spinnerCategory" />

        <Spinner
            android:id="@+id/spinnerMaterial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewMaterial"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewDynasty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Dynasty Period *"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/spinnerMaterial"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spinnerDynasty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewDynasty"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- OPTIONAL FIELDS -->
        <TextView
            android:id="@+id/textViewCulturalOrigin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Cultural Origin"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/spinnerDynasty"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextCulturalOrigin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="e.g., Ancient China"
            android:inputType="text"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewCulturalOrigin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewDimensions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Dimensions"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextCulturalOrigin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextDimensions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="e.g., 15cm x 10cm x 5cm"
            android:inputType="text"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewDimensions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewConditionReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Condition Report"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextDimensions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextConditionReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="e.g., Intact, minor wear"
            android:inputType="text"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewConditionReport"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewCurrentLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Current Location"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextConditionReport"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextCurrentLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="e.g., Museum of Fine Arts"
            android:inputType="text"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewCurrentLocation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewAcquisitionMethod"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Acquisition Method"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextCurrentLocation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextAcquisitionMethod"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="e.g., Donation, Purchase"
            android:inputType="text"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewAcquisitionMethod"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewProvenance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Provenance"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextAcquisitionMethod"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextProvenance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="e.g., Excavated in 1990"
            android:inputType="text"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewProvenance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewAccessionNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Accession Number"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextProvenance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextAccessionNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="e.g., ACC-2024-001"
            android:inputType="text"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewAccessionNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- NOTES -->
        <TextView
            android:id="@+id/textViewNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Notes"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextAccessionNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Additional notes"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewNotes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!--IMAGE PICKER SECTION-->
        <TextView
            android:id="@+id/textViewImagePicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Artifact Image"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextNotes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/artifactImageView"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_image"
            android:background="@android:drawable/editbox_background"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewImagePicker"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/buttonPickImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pick Image"
            android:layout_marginStart="16dp"
            android:backgroundTint="#B09867"
            app:layout_constraintTop_toTopOf="@+id/artifactImageView"
            app:layout_constraintStart_toEndOf="@+id/artifactImageView"
            app:layout_constraintBottom_toBottomOf="@+id/artifactImageView" />


        <!--ADD BUTTON-->
        <Button
            android:id="@+id/buttonAdd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Add Artifact"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/artifactImageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
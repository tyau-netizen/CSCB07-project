<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp"
    tools:context=".AddItemFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOOLBAR -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_add_artifact"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="#FFFFFF"
            android:elevation="2dp"
            app:title="Add Artifact"
            app:titleTextColor="#222222"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
            app:navigationIconTint="#B09867"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- MANDATORY FIELDS -->
        <TextView
            android:id="@+id/textViewLotNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="LOT NUMBER *"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar_add_artifact"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutLotNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="e.g., LOT001"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewLotNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextLotNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textViewName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="NAME *"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutLotNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Artifact name"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textViewDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="DESCRIPTION *"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Description"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textViewCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CATEGORY *"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewCategory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewMaterial"
            android:layout_width="0dp"
            android:layout_marginTop="16dp"
            android:layout_height="wrap_content"
            android:text="MATERIAL *"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spinnerCategory" />

        <Spinner
            android:id="@+id/spinnerMaterial"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewMaterial"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewDynasty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="DYNASTY PERIOD *"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/spinnerMaterial"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spinnerDynasty"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewDynasty"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- OPTIONAL FIELDS -->
        <TextView
            android:id="@+id/textViewCulturalOrigin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CULTURAL ORIGIN"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/spinnerDynasty"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCulturalOrigin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:hint="e.g., Ancient China"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewCulturalOrigin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextCulturalOrigin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textViewDimensions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="DIMENSIONS"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutCulturalOrigin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDimensions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="e.g., 15cm x 10cm x 5cm"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewDimensions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextDimensions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textViewConditionReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CONDITION REPORT"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutDimensions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutConditionReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="e.g., Intact, minor wear"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewConditionReport"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextConditionReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textViewCurrentLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CURRENT LOCATION"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutConditionReport"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCurrentLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="e.g., Museum of Fine Arts"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewCurrentLocation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextCurrentLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>


        <TextView
            android:id="@+id/textViewAcquisitionMethod"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ACQUISITION METHOD"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutCurrentLocation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAcquisitionMethod"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="e.g., Donation, Purchase"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewAcquisitionMethod"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextAcquisitionMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textViewProvenance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="PROVENANCE"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutAcquisitionMethod"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutProvenance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="e.g., Excavated in 1990"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewProvenance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextProvenance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textViewAccessionNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ACCESSION NUMBER"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutProvenance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAccessionNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="e.g., ACC-2024-001"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewAccessionNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextAccessionNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- NOTES -->
        <TextView
            android:id="@+id/textViewNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="NOTES"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutAccessionNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Additional notes"
            app:hintTextColor="#B09867"
            app:boxStrokeColor="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/textViewNotes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textColor="#222222"
                android:inputType="textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--IMAGE PICKER SECTION-->
        <TextView
            android:id="@+id/textViewImagePicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ARTIFACT IMAGE"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:textColor="#B09867"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutNotes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/artifactImageView"
            android:layout_width="0dp"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_image"
            android:background="#E0E0E0"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewImagePicker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/buttonPickImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:text="Pick Image"
            android:fontFamily="@font/roboto_condensed_regular"
            android:textColor="#B09867"
            app:strokeColor="#B09867"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/artifactImageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!--ADD BUTTON-->
        <Button
            android:id="@+id/buttonAdd"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="ADD ARTIFACT"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:letterSpacing="0.05"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#B09867"
            app:layout_constraintTop_toBottomOf="@+id/buttonPickImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Cancel / Back to Home Button -->
        <Button
            android:id="@+id/buttonCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:fontFamily="@font/roboto_condensed_regular"
            android:layout_marginBottom="32dp"
            android:textColor="#808080"
            app:layout_constraintTop_toBottomOf="@+id/buttonAdd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>